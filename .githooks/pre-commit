#!/bin/sh

# Pre-commit hook to run linting, type checking, and formatting

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "No files to check."
  exit 0
fi

# Filter staged files for JS/TS files
STAGED_JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx)$')

if [ -n "$STAGED_JS_FILES" ]; then
  echo "Running type check..."
  npx tsc --noEmit
  TYPECHECK_EXIT_CODE=$?

  if [ $TYPECHECK_EXIT_CODE -ne 0 ]; then
    echo "❌ Type check failed. Please fix the errors before committing."
    exit 1
  fi

  echo "Running ESLint on staged files..."
  echo "$STAGED_JS_FILES" | xargs npx eslint --max-warnings=0 --fix
  LINT_EXIT_CODE=$?

  if [ $LINT_EXIT_CODE -ne 0 ]; then
    echo "❌ ESLint failed. Please fix the errors before committing."
    exit 1
  fi

  echo "Running Prettier on staged files..."
  echo "$STAGED_JS_FILES" | xargs npx prettier --write
  FORMAT_EXIT_CODE=$?

  if [ $FORMAT_EXIT_CODE -ne 0 ]; then
    echo "❌ Prettier failed. Please fix the errors before committing."
    exit 1
  fi
else
  echo "No JavaScript/TypeScript files to check."
fi

# Re-add only the originally staged files (in case prettier modified them)
echo "$STAGED_FILES" | xargs git add

echo "✅ Type checking, linting, and formatting complete."
exit 0
